<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="1_32_add_type_to_dividend" author="plan-man">
        <addColumn tableName="dividend">
            <column name="type" type="VARCHAR(255)" defaultValue="DIVIDEND">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <update tableName="dividend">
            <column name="type" value="TAX"/>
            <where>amount &lt; 0</where>
        </update>
    </changeSet>

</databaseChangeLog>
