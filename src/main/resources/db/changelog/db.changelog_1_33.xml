<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- A goal is never updated in place: a change closes the current row (valid_to, exclusive)
         and opens a new one, so past days keep the targets that applied to them. -->
    <changeSet id="1_33_create_health_goal" author="plan-man">
        <createTable tableName="health_goal">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_profile_id" type="VARCHAR(255)">
                <constraints nullable="false" foreignKeyName="health_goal_user_fk"
                             referencedTableName="user_profile" referencedColumnNames="username"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="valid_from" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="valid_to" type="DATE"/>
            <column name="kcal_target" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="protein_target_g" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="football_bonus_kcal" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="freeletics_bonus_kcal" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="steps_target" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="start_weight_kg" type="DECIMAL(5,1)">
                <constraints nullable="false"/>
            </column>
            <column name="target_weight_kg" type="DECIMAL(5,1)">
                <constraints nullable="false"/>
            </column>
            <column name="target_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="push_ups_target" type="INT"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="health_goal" indexName="health_goal_user_valid_idx">
            <column name="user_profile_id"/>
            <column name="valid_from"/>
        </createIndex>
    </changeSet>

    <!-- One row per user and date: a snapshot of the targets in force that day plus day values. -->
    <changeSet id="1_33_create_health_day" author="plan-man">
        <createTable tableName="health_day">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_profile_id" type="VARCHAR(255)">
                <constraints nullable="false" foreignKeyName="health_day_user_fk"
                             referencedTableName="user_profile" referencedColumnNames="username"/>
            </column>
            <column name="day_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="health_goal_id" type="BIGINT">
                <constraints foreignKeyName="health_day_goal_fk"
                             referencedTableName="health_goal" referencedColumnNames="id"/>
            </column>
            <column name="kcal_target" type="INT"/>
            <column name="protein_target_g" type="INT"/>
            <column name="steps_target" type="INT"/>
            <column name="steps" type="INT"/>
            <column name="resting_hr" type="INT"/>
            <column name="sleep_minutes" type="INT"/>
            <column name="paused" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="health_day" columnNames="user_profile_id, day_date"
                             constraintName="health_day_user_day_uq"/>
    </changeSet>

    <!-- end_date is the last paused day (inclusive); NULL while the pause is running. -->
    <changeSet id="1_33_create_health_pause" author="plan-man">
        <createTable tableName="health_pause">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_profile_id" type="VARCHAR(255)">
                <constraints nullable="false" foreignKeyName="health_pause_user_fk"
                             referencedTableName="user_profile" referencedColumnNames="username"/>
            </column>
            <column name="start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="end_date" type="DATE"/>
            <column name="reason" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="1_33_create_body_measurement" author="plan-man">
        <createTable tableName="body_measurement">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_profile_id" type="VARCHAR(255)">
                <constraints nullable="false" foreignKeyName="body_measurement_user_fk"
                             referencedTableName="user_profile" referencedColumnNames="username"/>
            </column>
            <column name="measured_on" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="measured_value" type="DECIMAL(6,1)">
                <constraints nullable="false"/>
            </column>
            <column name="source" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="body_measurement" columnNames="user_profile_id, type, measured_on"
                             constraintName="body_measurement_user_type_day_uq"/>
    </changeSet>

</databaseChangeLog>
